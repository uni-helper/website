{
  "name": "@uni-helper/website",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm update:uni-use && cross-env NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "dev": "nuxt dev",
    "generate": "pnpm update:uni-use && cross-env STATIC_CHANGELOG=1 NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "update:uni-use": "tsx scripts/update-uni-use-files.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.17.0",
    "@nuxt/ui": "^4.12.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "motion-v": "^2.12.0",
    "nuxt": "^4.6.4",
    "nuxt-gtag": "^5.1.0",
    "ogl": "^1.0.11",
    "pkg-types": "^2.4.0",
    "scule": "^1.3.0",
    "tailwind-merge": "^3.7.0",
    "theme-colors": "^0.1.0",
    "vis-network": "^10.1.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/mdc": "^0.23.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
